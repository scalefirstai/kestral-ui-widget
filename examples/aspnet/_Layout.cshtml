@* ASP.NET MVC / Razor Pages / Blazor Server: add once to the shared layout.
   Two auth options:
   1. Windows-integrated auth (typical intranet): put the gateway behind IIS/ARR with Windows auth,
      run it with AUTH_MODE=trusted-header, and leave getToken out. The widget sends cookies
      (credentials: 'include'), IIS authenticates, the proxy forwards X-Forwarded-User.
   2. OIDC / Entra: render a short-lived access token for the copilot audience into the page
      (or fetch it from your own /api/copilot-token endpoint) and return it from getToken. *@

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    @* Loader snippet: async, never blocks the page; calls made before it loads are queued. *@
    <script>
        (function (w, d, s, u) {
            w.FisCopilot = w.FisCopilot || function () { (w.FisCopilot.q = w.FisCopilot.q || []).push(arguments); };
            var j = d.createElement(s); j.async = true; j.src = u; d.head.appendChild(j);
        })(window, document, 'script', '@Configuration["Copilot:GatewayUrl"]/widget/fis-copilot.js');
    </script>
</head>
<body>
    @RenderBody()

    <script>
        FisCopilot('boot', {
            gatewayUrl: '@Configuration["Copilot:GatewayUrl"]',
            appId: '@Configuration["Copilot:AppId"]',
            appMnemonic: '@Configuration["Copilot:AppMnemonic"]',  // 3-character app code, e.g. ESR
            namespace: '@Configuration["Copilot:Namespace"]',
            title: '@Configuration["Copilot:Title"]',
            // Option 2 only:
            // getToken: () => fetch('/api/copilot-token', { credentials: 'same-origin' }).then(r => r.ok ? r.text() : null),
            getContext: () => ({
                screen: document.title,
                controller: '@ViewContext.RouteData.Values["controller"]',
                action: '@ViewContext.RouteData.Values["action"]'
            })
        });
    </script>
    @* Pass a server-side error shown on this page (e.g. from TempData / ModelState) to the copilot. *@
    @if (ViewData["ErrorCode"] != null)
    {
        <script>
            FisCopilot('error', { code: '@ViewData["ErrorCode"]', message: '@ViewData["ErrorMessage"]', source: 'server' });
        </script>
    }
</body>
</html>
