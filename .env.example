# Gateway
PORT=8787
ALLOWED_ORIGINS=https://eaglestar.fis.internal,https://copilot.desktop
APP_REGISTRY=config/apps.example.json

# bearer | trusted-header | none
AUTH_MODE=bearer
TRUSTED_USER_HEADER=x-forwarded-user

# http   real Eliza (production; contract in packages/gateway/src/eliza.js, see ADAPT HERE)
# claude local stand-in: Claude + the mock knowledge MCP server over knowledge/okf
# mock   canned answers, no network
ELIZA_MODE=mock
ELIZA_URL=https://eliza.internal
ELIZA_API_KEY=
ELIZA_TIMEOUT_MS=60000
KNOWLEDGE_MCP_SERVER=fis-knowledge

# ELIZA_MODE=claude only
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TURNS=6
# KNOWLEDGE_MCP_COMMAND=node packages/knowledge-mcp/src/server.js
# KNOWLEDGE_BUNDLE=knowledge/okf

RATE_LIMIT_PER_MIN=30
LOG_CONTENT=false
